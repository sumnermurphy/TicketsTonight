EXPO_PUBLIC_TICKETMASTER_API_KEY=your_ticketmaster_key
EXPO_PUBLIC_TICKETMASTER_PAGE_SIZE=100
EXPO_PUBLIC_TICKETMASTER_MAX_PAGES=3

# Spotify uses PKCE in the client. Do not add a client secret here.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=ticketstonight://spotify-auth
