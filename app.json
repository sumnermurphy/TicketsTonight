{
  "expo": {
    "name": "Tickets Tonight",
    "slug": "tickets-tonight",
    "scheme": "ticketstonight",
    "version": "0.1.0",
    "description": "A mobile-first gallery walk discovery preview for verified exhibitions, personalized routes, and active walk planning.",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icons/gallery-icon-512.png",
    "backgroundColor": "#F4F2ED",
    "primaryColor": "#111111",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ticketstonight.app"
    },
    "android": {
      "package": "com.ticketstonight.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F3EA"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "TicketsTonight Gallery Walk",
      "shortName": "Gallery Walk",
      "display": "standalone",
      "themeColor": "#111111",
      "backgroundColor": "#F4F2ED",
      "favicon": "./assets/icons/gallery-icon-192.png"
    }
  }
}
